DB_PORT=5432
REDIS_HOST=mastodon-redis
REDIS_PORT=6379
ES_ENABLED=false

SECRET_KEY_BASE=federationlabfederationlabfederationlabfederationlabfederationlab
OTP_SECRET=federationlabfederationlabfederationlabfederationlabfederationlab
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=federationlabdeterministickey000
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=federationlabkeyderivationsalt00
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=federationlabprimarykey000000000
