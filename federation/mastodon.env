# Test-only values for compose.federation.yaml. These are public, so never use them on a real server.
LOCAL_DOMAIN=mastodon.test
AUTHORIZED_FETCH=true
ALLOWED_PRIVATE_ADDRESSES=172.30.0.0/24
SSL_CERT_FILE=/certs/ca.crt

DB_HOST=mastodon-db
DB_USER=postgres
DB_NAME=postgres
