# To change a setting, run systemctl edit elysium instead of editing this file, so that installing a newer version of it
# doesn't lose your change.

[Unit]
Description=Elysium server
# Only affects the start order if PostgreSQL is on this host. It doesn't wait for PostgreSQL to accept connections, so
# Restart below covers the server starting too early.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# Create this user and group first: see "Running as a service" in README.md.
User=elysium
Group=elysium
WorkingDirectory=/opt/elysium
# Location of your application.properties file. Copy it from application.properties.example in the repository.
Environment=SPRING_CONFIG_ADDITIONAL_LOCATION=/etc/elysium/application.properties
Environment=SPRING_PROFILES_ACTIVE=prod
# Optional environment variables that shouldn't be public, such as ELYSIUM_BOOTSTRAP_ADMIN_PASSWORD. Don't use Environment=
# for those, because any local user can read them with systemctl show. systemd reads this file as root, so it can be
# readable only by root.
EnvironmentFile=-/etc/elysium/elysium.env
ExecStart=/usr/bin/java -jar elysium.jar
Restart=on-failure
RestartSec=5
# The JVM exits with this status when systemctl stop sends it SIGTERM, which isn't a failure.
SuccessExitStatus=143

# Everything below limits what the server can do if it's compromised. Check the result with:
#   systemd-analyze security elysium.service

# Privileges. To listen on a port below 1024, set AmbientCapabilities=CAP_NET_BIND_SERVICE and
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE, and set PrivateUsers=false.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
PrivateUsers=true

# Filesystem. The server can only write to its private /tmp and /var/tmp, and to /dev/shm, which isn't private. Files it
# creates are private to its user. /home, /root and /run/user aren't visible, so the JAR and JDK can't be installed there.
# If you configure the server to write elsewhere, such as to a log file, allow that directory with ReadWritePaths.
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

# Kernel and host.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Processes. Other users' processes are hidden. ProcSubset=pid isn't set because it hides /proc/stat, which the JVM reads
# for its system CPU metrics. The server still runs with it, so you can add it if you don't need those.
ProtectProc=invisible
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

# Network. Federation and PostgreSQL need outbound access, so IP addresses aren't restricted.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System calls. MemoryDenyWriteExecute isn't set because it breaks the JVM's JIT compiler.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
