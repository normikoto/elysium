[Unit]
Description=Elysium server

[Service]
WorkingDirectory=/opt/elysium
# Location of the application.properties file. Copy the file from src/main/resources/application.proeprties.
Environment=SPRING_CONFIG_LOCATION=/etc/elysium/application.properties
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=/usr/bin/java -jar elysium.jar

[Install]
WantedBy=multi-user.target