[Unit]
Description=Elysium server

[Service]
WorkingDirectory=/opt/elysium
# Location of your application.properties file. Copy it from application.properties.example in the repository.
Environment=SPRING_CONFIG_ADDITIONAL_LOCATION=/etc/elysium/application.properties
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=/usr/bin/java -jar elysium.jar

[Install]
WantedBy=multi-user.target