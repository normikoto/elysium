# Copy this file to where SPRING_CONFIG_ADDITIONAL_LOCATION points, then edit it.
# Settings here override the defaults built into the JAR, so only add the ones you want to change.

# Required: the public URL of this server, with no path. Federating with other servers requires a public HTTPS URL.
# Don't change it after federating: actor URIs and the instance domain are derived from it.
elysium.instance.base-url=https://example.com

# Required: your PostgreSQL database. Migrations run automatically on startup.
spring.datasource.url=jdbc:postgresql://localhost:5432/elysium
spring.datasource.username=elysium
spring.datasource.password=

# Who can create an account at /signup: open lets anyone, once they've confirmed their email address, approval also needs an
# admin to approve each one, and closed only lets people with an invite from the create-invite command. Open and approval
# need the SMTP server below. The first account has to come from the create-user command, and becomes an admin.
#elysium.registration.mode=closed

# The SMTP server that sends email, such as the links that confirm a sign-up's address. Without a host, no email is sent.
#spring.mail.host=
#spring.mail.port=587
#spring.mail.username=
#spring.mail.password=
#spring.mail.properties.mail.smtp.starttls.required=true
# Required with a host: the address that email comes from.
#elysium.mail.from=

# Limits logins and sign-ups. Only turn this off if you enforce your own limits elsewhere.
#elysium.rate-limit.enabled=true

# The most characters a new status can have, counting its content warning. Each URL counts as 23 characters. Lowering this
# doesn't affect existing statuses.
#elysium.statuses.max-characters=5000

# How many fields each profile can have. Lowering this doesn't remove any, but a profile with more can't save its fields
# until it has few enough.
#elysium.profiles.max-fields=4
# The largest avatar or header that can be uploaded. Above 9MB, also raise spring.servlet.multipart.max-request-size,
# which is 20MB.
#elysium.profiles.max-image-size=8MB

# Where uploaded images are kept. Back this directory up along with the database, which refers to the files in it.
#elysium.media.directory=media

# How long a login session lasts without a request.
#server.servlet.session.timeout=30m

# Limits on what each other server can deliver to the inboxes. A server that reaches one gets a 429 and tries again later.
# Subdomains count as the same server. To stop limiting a server you trust, list its domain in exempt-domains.
#elysium.federation.inbox-limits.activities-per-minute=120
#elysium.federation.inbox-limits.data-per-hour=20MB
#elysium.federation.inbox-limits.exempt-domains=

# This should not normally be set. Lets requests to other servers reach these private networks, as a comma-separated list
# in CIDR form. It's only for federating with servers on a private network, because anyone can make this server send
# requests to any host, and could then reach anything on these networks.
#elysium.federation.allowed-private-networks=

# Experimental. Changes how background jobs are picked up, which may help with more than one copy of the server. Set both
# or neither, because the first alone makes each copy hold jobs that other copies can't run. See docs/configuration.md.
#db-scheduler.polling-strategy=LOCK_AND_FETCH
#db-scheduler.polling-strategy-upper-limit-fraction-of-threads=1.0

# Uncomment if a reverse proxy is the only way to reach this server, so that redirects use the public URL and rate limits
# apply to each client's address. Without this behind a proxy, all clients share one limit. The server trusts the
# forwarded headers it receives, so the proxy must set them itself, or clients can get around the rate limits by making up
# their addresses. nginx needs configuring to do this: see docs/configuration.md.
#server.forward-headers-strategy=native
