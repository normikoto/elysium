# Copy this file to where SPRING_CONFIG_ADDITIONAL_LOCATION points, then edit it.
# Settings here override the defaults built into the JAR, so only add the ones you want to change.

# Required: the public URL of this server, with no path. Federating with other servers requires a public HTTPS URL.
# Don't change it after federating: actor URIs and the instance domain are derived from it.
elysium.instance.base-url=https://example.com

# Required: your PostgreSQL database. Migrations run automatically on startup.
spring.datasource.url=jdbc:postgresql://localhost:5432/elysium
spring.datasource.username=elysium
spring.datasource.password=

# Lets anyone create an account at /signup. There's no email confirmation. The first account has to come from the
# create-user command, and becomes an admin.
#elysium.registration.enabled=false

# Limits logins and sign-ups. Only turn this off if you enforce your own limits elsewhere.
#elysium.rate-limit.enabled=true

# The most characters a new status can have, counting its content warning. Each URL counts as 23 characters. Lowering this
# doesn't affect existing statuses.
#elysium.statuses.max-characters=5000

# How long a login session lasts without a request.
#server.servlet.session.timeout=30m

# This should not normally be set. Lets requests to other servers reach these private networks, as a comma-separated list
# in CIDR form. It's only for federating with servers on a private network, because anyone can make this server send
# requests to any host, and could then reach anything on these networks.
#elysium.federation.allowed-private-networks=

# Uncomment if a reverse proxy is the only way to reach this server, so that redirects use the public URL and rate limits
# apply to each client's address. Without this behind a proxy, all clients share one limit. The server trusts the
# forwarded headers it receives, so the proxy must set them itself, or clients can get around the rate limits by making up
# their addresses. nginx needs configuring to do this: see docs/configuration.md.
#server.forward-headers-strategy=native
