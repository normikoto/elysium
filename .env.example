# Copy this file to .env, next to compose.yaml, then edit it. Put values containing $ in single quotes.

# Required: the public URL of this server, with no path. Federating with other servers requires a public HTTPS URL.
# Don't change it after federating: actor URIs and the instance domain are derived from it.
ELYSIUM_INSTANCE_BASE_URL=

# Required: the database password. It can't contain ${, because the server would read that as a placeholder.
# PostgreSQL only reads this and the two settings below when first creating the database. Changing them here later
# doesn't change the database, and the server won't be able to connect.
POSTGRES_PASSWORD=
#POSTGRES_USER=elysium
#POSTGRES_DB=elysium

# Who can create an account at /signup: open lets anyone, once they've confirmed their email address, approval also needs an
# admin to approve each one, and closed only lets people with an invite from the create-invite command. Open and approval
# need the SMTP server below. The first account has to come from the create-user command, and becomes an admin.
#ELYSIUM_REGISTRATION_MODE=closed

# The SMTP server that sends email, such as the links that confirm a sign-up's address. Without a host, no email is sent.
#SPRING_MAIL_HOST=
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
# Required with a host: the address that email comes from.
#ELYSIUM_MAIL_FROM=

# Limits logins and sign-ups. Only turn this off if you enforce your own limits elsewhere.
#ELYSIUM_RATELIMIT_ENABLED=true

# How many fields each profile can have. Lowering this doesn't remove any, but a profile with more can't save its fields
# until it has few enough.
#ELYSIUM_PROFILES_MAXFIELDS=4

# The largest avatar or header that can be uploaded. Uploaded files are kept in the media-data volume: back it up along
# with the database.
#ELYSIUM_PROFILES_MAXIMAGESIZE=8MB

# The largest image, video, and audio file that can be attached to a post. Video and audio keep their metadata.
#ELYSIUM_ATTACHMENTS_MAXIMAGESIZE=16MB
#ELYSIUM_ATTACHMENTS_MAXVIDEOSIZE=100MB
#ELYSIUM_ATTACHMENTS_MAXAUDIOSIZE=40MB
# How many uploads each account can have that aren't in a post yet, and how long they're kept for one.
#ELYSIUM_ATTACHMENTS_MAXUNATTACHEDUPLOADS=20
#ELYSIUM_ATTACHMENTS_UNATTACHEDRETENTION=1d
# How long a deleted post's attachments are kept, so that it can be posted again.
#ELYSIUM_ATTACHMENTS_REDRAFTRETENTION=1h
# Whether copies of other servers' attachments are kept here, for how long, and how much each server can have downloaded
# in an hour. Past that, they're linked to their server.
#ELYSIUM_ATTACHMENTS_REMOTECACHEENABLED=true
#ELYSIUM_ATTACHMENTS_REMOTECACHERETENTION=30d
#ELYSIUM_ATTACHMENTS_REMOTEDOWNLOADBUDGET=2GB

# How long a login session lasts without a request.
#SERVER_SERVLET_SESSION_TIMEOUT=30m

# Limits on what each other server can deliver to the inboxes. A server that reaches one gets a 429 and tries again later.
# Subdomains count as the same server. To stop limiting a server you trust, list its domain in the last setting.
#ELYSIUM_FEDERATION_INBOXLIMITS_ACTIVITIESPERMINUTE=120
#ELYSIUM_FEDERATION_INBOXLIMITS_DATAPERHOUR=20MB
#ELYSIUM_FEDERATION_INBOXLIMITS_EXEMPTDOMAINS=

# This should not normally be set. Lets requests to other servers reach these private networks, as a comma-separated list
# in CIDR form. It's only for federating with servers on a private network, because anyone can make this server send
# requests to any host, and could then reach anything on these networks.
#ELYSIUM_FEDERATION_ALLOWED_PRIVATE_NETWORKS=

# Experimental. Changes how background jobs are picked up, which may help with more than one copy of the server. Set both
# or neither, because the first alone makes each copy hold jobs that other copies can't run. See docs/configuration.md.
#DBSCHEDULER_POLLINGSTRATEGY=LOCK_AND_FETCH
#DBSCHEDULER_POLLINGSTRATEGYUPPERLIMITFRACTIONOFTHREADS=1.0
