# Copy this file to .env, next to compose.yaml, then edit it. Put values containing $ in single quotes.

# Required: the public URL of this server, with no path. Federating with other servers requires a public HTTPS URL.
# Don't change it after federating: actor URIs and the instance domain are derived from it.
ELYSIUM_INSTANCE_BASE_URL=https://example.com

# Required: the database password. PostgreSQL only reads it when first creating the database, so changing it here later
# doesn't change the password.
POSTGRES_PASSWORD=

# Creates this local actor on startup if it doesn't exist yet.
#ELYSIUM_BOOTSTRAP_ADMIN_USERNAME=admin

# Sets the admin's password if it doesn't have one. It never replaces an existing password. Must be 8 to 128 characters.
#ELYSIUM_BOOTSTRAP_ADMIN_PASSWORD=

# Lets anyone create an account at /signup. There's no email confirmation or rate limiting.
#ELYSIUM_REGISTRATION_ENABLED=false
