# Copy this file to .env, next to compose.yaml, then edit it. Put values containing $ in single quotes.

# Required: the public URL of this server, with no path. Federating with other servers requires a public HTTPS URL.
# Don't change it after federating: actor URIs and the instance domain are derived from it.
ELYSIUM_INSTANCE_BASE_URL=

# Required: the database password. It can't contain ${, because the server would read that as a placeholder.
# PostgreSQL only reads this and the two settings below when first creating the database. Changing them here later
# doesn't change the database, and the server won't be able to connect.
POSTGRES_PASSWORD=
#POSTGRES_USER=elysium
#POSTGRES_DB=elysium

# Lets anyone create an account at /signup. There's no email confirmation. The first account has to come from the
# create-user command, and becomes an admin.
#ELYSIUM_REGISTRATION_ENABLED=false

# Limits logins and sign-ups. Only turn this off if you enforce your own limits elsewhere.
#ELYSIUM_RATELIMIT_ENABLED=true

# How long a login session lasts without a request.
#SERVER_SERVLET_SESSION_TIMEOUT=30m

# Limits on what each other server can deliver to the inboxes. A server that reaches one gets a 429 and tries again later.
# Subdomains count as the same server. To stop limiting a server you trust, list its domain in the last setting.
#ELYSIUM_FEDERATION_INBOXLIMITS_ACTIVITIESPERMINUTE=120
#ELYSIUM_FEDERATION_INBOXLIMITS_DATAPERHOUR=20MB
#ELYSIUM_FEDERATION_INBOXLIMITS_EXEMPTDOMAINS=

# This should not normally be set. Lets requests to other servers reach these private networks, as a comma-separated list
# in CIDR form. It's only for federating with servers on a private network, because anyone can make this server send
# requests to any host, and could then reach anything on these networks.
#ELYSIUM_FEDERATION_ALLOWED_PRIVATE_NETWORKS=

# Experimental. Changes how background jobs are picked up, which may help with more than one copy of the server. Set both
# or neither, because the first alone makes each copy hold jobs that other copies can't run. See docs/configuration.md.
#DBSCHEDULER_POLLINGSTRATEGY=LOCK_AND_FETCH
#DBSCHEDULER_POLLINGSTRATEGYUPPERLIMITFRACTIONOFTHREADS=1.0
